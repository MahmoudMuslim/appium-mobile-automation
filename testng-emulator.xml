<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Emulator suite: runs on a Google Play AVD image.
  The built-in app scenario uses Google Clock (DeskClock) because Play images do
  not ship Google Calculator. Run with:
    mvn test -Dsurefire.suiteXmlFiles=testng-emulator.xml
-->
<suite name="Appium Mini Task - Emulator Suite" verbose="1">

    <!-- Phase 2: built-in Clock app + real ApiDemos APK, on the AVD emulator -->
    <test name="Phase2 Emulator - Built-in app and APK">
        <classes>
            <class name="com.mahmoud.appium.phase2.BuiltInAppEmulatorTest"/>
            <class name="com.mahmoud.appium.phase2.ApkInstallTest"/>
        </classes>
    </test>

</suite>